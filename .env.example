# Copy to .env and adjust. .env is gitignored and must never be committed.
# No IB username/password goes here: you log in (with 2FA) inside IB Gateway / TWS,
# and this code only talks to that local socket.

# paper | live
IB_MODE=paper

# IB Gateway: 4002 = paper, 4001 = live.  TWS: 7497 = paper, 7496 = live.
# The mode/port combination is validated at startup.
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1

# Optional: pin the account ID you expect (e.g. DU1234567 for paper). Connection is refused on mismatch.
IB_ACCOUNT=

# Safety switches. Defaults are the safest values.
# IB_READONLY=true blocks every order from this code (also tick "Read-Only API" in Gateway for a hard block).
IB_READONLY=true
# Must be explicitly true, in addition to IB_MODE=live, before any live order can be sent.
IB_ALLOW_LIVE_ORDERS=false

# Per-order guardrails (account currency)
IB_MAX_CONTRACTS_PER_ORDER=5
IB_MAX_DEBIT_PER_ORDER=2000

# Dashboard (`ibt dashboard`), served on http://127.0.0.1:8050 only.
# It connects to BOTH sessions if running: a paper Gateway on IB_PAPER_PORT and a live one on IB_LIVE_PORT.
# The Paper/Live switch in the top bar picks which one you see and trade.
IB_DASHBOARD_CLIENT_ID=11
IB_DASHBOARD_PORT=8050
IB_PAPER_PORT=4002
IB_LIVE_PORT=4001
# Orders from the dashboard to the PAPER session (account must be DU...). Live orders additionally need
# IB_READONLY=false AND IB_ALLOW_LIVE_ORDERS=true, plus typing LIVE in the confirmation box.
IB_PAPER_ORDERS=true
# 1 = live only, 3 = delayed where you have no live subscription
IB_MARKET_DATA_TYPE=3

# Optional: Flex Web Service for full trade/fee history (Client Portal > Performance & Reports > Flex Queries)
IB_FLEX_TOKEN=
IB_FLEX_QUERY_ID=
